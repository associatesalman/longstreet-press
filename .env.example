# Longstreet Press: Book Marketing inquiry email (server-side only).
# Copy this file to .env for local use (`npm run dev` and `npm start` both read .env,
# never this file), or enter the same names in your host's environment settings.
# Never prefix these with VITE_: that would put them in the public browser bundle.
# The real .env is gitignored. Never put real passwords in this file.

# --- Required -----------------------------------------------------------------

# Sender address your SMTP provider has authorized for this account.
# Emails go out as "Longstreet Press" <this address>.
CONTACT_FROM_EMAIL=support@longstreet.press

# SMTP connection details. For Google Workspace/Gmail, SMTP_PASS is a Google App Password.
SMTP_HOST=smtp.gmail.com
SMTP_USER=support@longstreet.press
SMTP_PASS=

# --- Optional -----------------------------------------------------------------

# Port 587 (STARTTLS) is the default. Use 465 with SMTP_SECURE=true for implicit TLS.
SMTP_PORT=587
SMTP_SECURE=false

# Inbox(es) that receive inquiries, comma-separated. Defaults on the server to
# associatesalman@gmail.com when empty; never sent to or shown in the browser.
CONTACT_RECIPIENT_EMAIL=support@longstreet.press,associatesalman@gmail.com

# Set to "true" only when the Node server runs behind a reverse proxy/load balancer,
# so per-visitor rate limiting uses the X-Forwarded-For address.
TRUST_PROXY=

# Port for `npm start` (most hosts set this automatically).
PORT=
