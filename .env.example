# Longstreet Press: Book Marketing inquiry email (server-side only).
# Copy this file to .env for local use, or enter the same names in your host's
# environment settings. Never prefix these with VITE_: that would put them in the
# public browser bundle. The real .env is gitignored.

# --- Required -----------------------------------------------------------------

# Sender address your SMTP provider has verified/authorized for this account
# (for example no-reply@yourdomain.com). Emails go out as "Longstreet Press" <this address>.
CONTACT_FROM_EMAIL=

# SMTP connection details from your email provider's SMTP settings page.
SMTP_HOST=
SMTP_USER=
SMTP_PASS=

# --- Optional -----------------------------------------------------------------

# Port 587 (STARTTLS) is the default. Use 465 with SMTP_SECURE=true for implicit TLS.
SMTP_PORT=587
SMTP_SECURE=

# Inbox that receives inquiries. Defaults on the server to associatesalman@gmail.com
# when empty; it is never sent to or shown in the browser.
CONTACT_RECIPIENT_EMAIL=

# Set to "true" only when the Node server runs behind a reverse proxy/load balancer,
# so per-visitor rate limiting uses the X-Forwarded-For address.
TRUST_PROXY=

# Port for `npm start` (most hosts set this automatically).
PORT=
